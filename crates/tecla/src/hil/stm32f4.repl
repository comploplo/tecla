// STM32F411 — Cortex-M4F, minimal stubs for Embassy firmware boot.
//
// Memory map (from STM32F411 reference manual):
//   0x08000000  Flash         512 KB
//   0x20000000  SRAM          128 KB
//   0x40000000  APB1 peripherals
//   0x40010000  APB2 peripherals
//   0x40020000  AHB1 peripherals

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x80000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x20000

apb1: Memory.MappedMemory @ sysbus 0x40000000
    size: 0x10000

apb2: Memory.MappedMemory @ sysbus 0x40010000
    size: 0x10000

ahb1: Memory.MappedMemory @ sysbus 0x40020000
    size: 0x20000

nvic: IRQControllers.NVIC @ sysbus 0xe000e000
    systickFrequency: 100000000
    -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4f"
    nvic: nvic
