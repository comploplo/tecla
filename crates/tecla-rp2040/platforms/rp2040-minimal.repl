// Minimal RP2040 platform for Renode HIL smoke tests.
//
// Single-core Cortex-M0+ with just enough peripheral stubs to boot
// embassy-rp firmware: PSM must be MappedMemory so write_and_wait in
// __pre_init terminates (unmapped reads return 0, failing the read-back
// loop in write_and_wait). SIO is mapped so spinlock accesses don't fault.
//
// Memory map (from RP2040 datasheet):
//   0x10000000  Flash (XIP)     2 MB
//   0x20000000  SRAM          264 KB
//   0x40010000  PSM             4 KB  (+ 3 atomic alias pages)
//   0xD0000000  SIO             4 KB  (min Renode page)

flash: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x200000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x42000

psm: Memory.MappedMemory @ sysbus 0x40010000
    size: 0x4000

sio: Memory.MappedMemory @ sysbus 0xD0000000
    size: 0x1000

nvic: IRQControllers.NVIC @ sysbus 0xe000e000
    systickFrequency: 125000000
    -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m0+"
    nvic: nvic
